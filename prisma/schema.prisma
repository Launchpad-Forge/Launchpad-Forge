}
// ------------------------------------------------------
// Marketing & Landing Page Content
// ------------------------------------------------------

model Service {
  id          String   @id @default(uuid())
  number      String
  title       String
  description String?
  details     String[] 
  icon        String?

  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAtString()

  @@rls
}

policy_all allow_anon_Service {
  target = Service
  roles = [anon, authenticated]
  using = "true"
  withCheck = "true"
}


model PortfolioProject {
  id          String   @id @default(uuid())
  title       String
  subtitle    String
  label       String
  gradient    String
  items       Json     

  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAtString()

  @@rls
}

policy_all allow_anon_PortfolioProject {
  target = PortfolioProject
  roles = [anon, authenticated]
  using = "true"
  withCheck = "true"
}

