// use prisma-8

namespace public {

// ------------------------------------------------------
// Core CRM Schema: Launchpad Forge Personal CRM
// ------------------------------------------------------

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          String   
  
  createdAt     DateTime @default(now())
  updatedAt     temporal.updatedAtString()
  
  leads         Lead[]       @relation("LeadAssignedUser")
  activities    Activity[]   @relation("ActivityAuthor")
  @@rls
}

model Company {
  id            String   @id @default(uuid())
  name          String
  website       String?
  industry      String?
  companySize   String?
  location      String?
  email         String?
  phone         String?
  source        String?
  status        String?  
  notes         String?
  
  createdAt     DateTime @default(now())
  updatedAt     temporal.updatedAtString()

  contacts      Contact[]
  leads         Lead[]
  opportunities Opportunity[]
  client        Client?
  proposals     Proposal[]
  activities    Activity[]
  followUps     FollowUp[]
  attachments   Attachment[]

  @@index([status])
  @@rls
}

model Contact {
  id            String   @id @default(uuid())
  companyId     String?
  name          String
  jobTitle      String?
  email         String?
  phone         String?
  linkedin      String?
  whatsapp      String?
  location      String?
  notes         String?
  
  createdAt     DateTime @default(now())
  updatedAt     temporal.updatedAtString()

  company       Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunities Opportunity[] @relation("PrimaryContact")
  activities    Activity[]
  followUps     FollowUp[]
  attachments   Attachment[]

  @@index([companyId])
  @@index([email])
  @@rls
}

model Lead {
  id                  String   @id @default(uuid())
  name                String
  companyName         String?
  email               String?
  phone               String?
  website             String?
  source              String?
  industry            String?
  serviceInterestedIn String?
  estimatedBudget     Float?
  priority            String?  
  status              String   
  pipelineStage       String?
  leadScore           Int?
  nextFollowUp        DateTime?
  notes               String?
  
  assignedUserId      String?
  companyId           String?
  
  createdAt           DateTime @default(now())
  updatedAt           temporal.updatedAtString()

  assignedUser        User?    @relation("LeadAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  company             Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  activities          Activity[]
  followUps           FollowUp[]
  attachments         Attachment[]

  @@index([status])
  @@index([assignedUserId])
  @@index([email])
  @@rls
}

model Opportunity {
  id                  String   @id @default(uuid())
  companyId           String?
  primaryContactId    String?
  title               String
  estimatedValue      Float?
  probability         Int?     
  expectedCloseDate   DateTime?
  stage               String   
  service             String?
  source              String?
  priority            String?  
  nextFollowUp        DateTime?
  lossReason          String?
  notes               String?
  
  createdAt           DateTime @default(now())
  updatedAt           temporal.updatedAtString()

  company             Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  primaryContact      Contact? @relation("PrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  activities          Activity[]
  followUps           FollowUp[]
  attachments         Attachment[]
  proposals           Proposal[]

  @@index([stage])
  @@index([companyId])
  @@index([primaryContactId])
  @@rls
}

// ------------------------------------------------------
// Timeline & Follow-ups
// ------------------------------------------------------

model Activity {
  id              String   @id @default(uuid())
  type            String   // NOTE, CALL, EMAIL, MEETING, FOLLOW_UP, STAGE_CHANGE
  title           String
  description     String?
  date            DateTime @default(now())
  status          String   
  
  authorId        String?
  leadId          String?
  contactId       String?
  companyId       String?
  opportunityId   String?
  projectId       String?
  
  createdAt       DateTime @default(now())
  updatedAt       temporal.updatedAtString()
  
  author          User?        @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  lead            Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  project         Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([contactId])
  @@index([companyId])
  @@index([opportunityId])
  @@index([projectId])
  @@index([date])
  @@index([type])
  @@rls
}

model FollowUp {
  id              String   @id @default(uuid())
  title           String
  dueDate         DateTime
  priority        String   
  status          String   
  notes           String?
  
  leadId          String?
  contactId       String?
  companyId       String?
  opportunityId   String?
  
  createdAt       DateTime @default(now())
  updatedAt       temporal.updatedAtString()
  
  lead            Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([dueDate])
  @@index([status])
  @@index([leadId])
  @@index([contactId])
  @@index([companyId])
  @@index([opportunityId])
  @@rls
}

// ------------------------------------------------------
// Tags & Attachments
// ------------------------------------------------------

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   
  createdAt DateTime @default(now())
  @@rls
}

model Attachment {
  id            String   @id @default(uuid())
  fileName      String
  fileUrl       String
  provider      String   
  size          Int?
  mimeType      String?
  
  leadId        String?
  contactId     String?
  companyId     String?
  opportunityId String?
  
  createdAt     DateTime @default(now())

  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@rls
}

// ------------------------------------------------------
// Sales & Delivery
// ------------------------------------------------------

model Proposal {
  id              String   @id @default(uuid())
  proposalNumber  String   @unique
  clientId        String?
  companyId       String?
  opportunityId   String?
  title           String
  description     String?
  validUntil      DateTime?
  status          String   
  subtotal        Float    
  discount        Float    
  tax             Float    
  total           Float    
  
  createdAt       DateTime @default(now())
  updatedAt       temporal.updatedAtString()

  client          Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  items           ProposalItem[]

  @@index([status])
  @@index([companyId])
  @@rls
}

model ProposalItem {
  id              String   @id @default(uuid())
  proposalId      String
  service         String
  description     String?
  quantity        Int      
  unitPrice       Float    
  discount        Float    
  total           Float    
  
  createdAt       DateTime @default(now())
  updatedAt       temporal.updatedAtString()

  proposal        Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  @@rls
}

model Client {
  id              String   @id @default(uuid())
  companyId       String?  @unique
  status          String   
  notes           String?
  
  createdAt       DateTime @default(now())
  updatedAt       temporal.updatedAtString()

  company         Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  proposals       Proposal[]
  projects        Project[]
  invoices        Invoice[]

  @@index([status])
  @@rls
}

// ------------------------------------------------------
// Delivery
// ------------------------------------------------------

model Project {
  id                  String   @id @default(uuid())
  clientId            String?
  name                String
  description         String?
  startDate           DateTime?
  expectedCompletion  DateTime?
  status              String   
  budget              Float?
  priority            String?  
  
  createdAt           DateTime @default(now())
  updatedAt           temporal.updatedAtString()

  client              Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tasks               Task[]
  invoices            Invoice[]
  activities          Activity[]

  @@index([status])
  @@index([clientId])
  @@rls
}

model Task {
  id              String   @id @default(uuid())
  projectId       String
  title           String
  description     String?
  status          String   
  priority        String?  
  dueDate         DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       temporal.updatedAtString()

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@rls
}

// ------------------------------------------------------
// Finance
// ------------------------------------------------------

model Invoice {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique
  clientId        String?
  projectId       String?
  issueDate       DateTime?
  dueDate         DateTime?
  status          String   
  subtotal        Float    
  tax             Float    
  discount        Float    
  total           Float    
  
  createdAt       DateTime @default(now())
  updatedAt       temporal.updatedAtString()

  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items           InvoiceItem[]
  payments        Payment[]

  @@index([status])
  @@index([clientId])
  @@index([dueDate])
  @@rls
}

model InvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String
  description     String
  quantity        Int      
  unitPrice       Float    
  total           Float    
  
  createdAt       DateTime @default(now())
  updatedAt       temporal.updatedAtString()

  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  @@rls
}

model Payment {
  id              String   @id @default(uuid())
  invoiceId       String
  amount          Float
  date            DateTime @default(now())
  method          String?
  reference       String?
  notes           String?
  
  createdAt       DateTime @default(now())
  updatedAt       temporal.updatedAtString()

  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  @@rls
}

